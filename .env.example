# ==============================================================================
# Environment Configuration Template
# Duplicate this file to .env.local and populate with your project credentials:
#   cp .env.example .env.local
# Strictly never commit .env.local or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Firebase Client SDK Configuration (Public / Browser Safe)
# Obtain these from: Firebase Console > Project Settings > General > Your apps (Web)
# ------------------------------------------------------------------------------

# Firebase Web API key
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here

# Firebase Auth domain (e.g., your-project-id.firebaseapp.com)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# Google Cloud / Firebase project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id

# Cloud Storage bucket URL (e.g., your-project-id.firebasestorage.app)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app

# Firebase Cloud Messaging sender ID
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Firebase Web App ID (e.g., 1:1234567890:web:abcdef123456)
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google Analytics 4 measurement ID (optional, e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ------------------------------------------------------------------------------
# Portfolio Application & Site Settings
# ------------------------------------------------------------------------------

# Public canonical site URL (used in SEO metadata, sitemap.xml, robots.txt, and OpenGraph images)
NEXT_PUBLIC_SITE_URL=https://kiransinha.dev

# ------------------------------------------------------------------------------
# Firebase App Check (reCAPTCHA v3)
# Obtain from: Firebase Console > App Check > Apps > Web App
# ------------------------------------------------------------------------------

# Public reCAPTCHA v3 site key for Firebase App Check verification
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key

# Optional debug token for local development (set in .env.local only)
# NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=your_debug_token_here

# ------------------------------------------------------------------------------
# Supabase Client Configuration (Public / Browser Safe)
# Obtain from: Supabase Dashboard > Project Settings > API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your_project_id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_publishable_key

# ------------------------------------------------------------------------------
# Data Backend Feature Flag (firebase | supabase)
# Defaults to firebase until cutover approval.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DATA_BACKEND=firebase

# ------------------------------------------------------------------------------
# Cloudflare Turnstile Bot Protection
# ------------------------------------------------------------------------------
# Public Turnstile site key (browser-facing)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Secret key for server-side token verification (STRICTLY SERVER ONLY, do NOT prefix with NEXT_PUBLIC)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key


