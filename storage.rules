rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Verify user is authenticated and matches specific Admin UID
    // REPLACE <MY_ADMIN_UID> with your actual Firebase Auth UID (Firebase Console > Authentication > Users)
    function isAdmin() {
      return request.auth != null && request.auth.uid == "<MY_ADMIN_UID>";
    }

    // Image validation: max 5MB, valid image mime type
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|svg\\+xml)');
    }

    // PDF document validation: max 10MB, application/pdf
    function isValidResume() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // 1. Profile avatars (public read for portfolio visitor, admin-only write)
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // 2. Project screenshots and thumbnails
    match /projects/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // 3. Certification badges
    match /certifications/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // 4. General portfolio image uploads
    match /uploads/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // 5. Resume PDF documents (public read for portfolio viewers, admin-only write)
    match /resumes/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidResume();
      allow delete: if isAdmin();
    }

    // Deny all other unmatched storage paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
