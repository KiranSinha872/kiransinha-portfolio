rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to restrict write operations to the authenticated admin user UID
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid != null
      );
    }

    // Public read access for uploaded portfolio assets (avatars, projects screenshots, certification badges)
    // Write/delete/update access restricted to the authenticated admin
    match /avatars/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /projects/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /certifications/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // Default rule
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
