rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: profile
// Document ID: main (or string ID)
// Fields:
//   - name: string (optional, 0-100 chars)
//   - title: string (optional, 0-200 chars)
//   - headline: string (optional, 0-200 chars)
//   - tagline: string (optional, 0-200 chars)
//   - bio: string (optional, 0-5000 chars)
//   - about: string (optional, 0-10000 chars)
//   - avatarUrl: string (optional, 0-1000 chars)
//   - resumeUrl: string (optional, 0-1000 chars)
//   - location: string (optional, 0-100 chars)
//   - focusArea: string (optional, 0-200 chars)
//   - mindset: string (optional, 0-200 chars)
//   - email: string (optional, 0-254 chars)
//   - contactEmail: string (optional, 0-254 chars)
//   - phone: string (optional, 0-50 chars)
//   - linkedinUrl: string (optional, 0-500 chars)
//   - githubUrl: string (optional, 0-500 chars)
//   - leetcodeUrl: string (optional, 0-500 chars)
//   - codechefUrl: string (optional, 0-500 chars)
//   - codeforcesUrl: string (optional, 0-500 chars)
//   - twitterUrl: string (optional, 0-500 chars)
//   - socials: list of maps (optional, max 20 items)
//   - createdAt: string/timestamp (optional, max 50 chars)
//   - updatedAt: string/timestamp (optional, max 50 chars)
//
// Collection: education
// Document ID: auto-generated or string ID
// Fields:
//   - institution: string (required, 1-200 chars)
//   - degree: string (required, 1-200 chars)
//   - fieldOfStudy: string (optional, 0-200 chars)
//   - startDate: string (optional, 0-50 chars)
//   - endDate: string (optional, 0-50 chars)
//   - isCurrent: bool (optional)
//   - grade: string (optional, 0-100 chars)
//   - location: string (optional, 0-100 chars)
//   - description: string (optional, 0-5000 chars)
//   - order: number (optional)
//   - createdAt: string/timestamp (optional, max 50 chars)
//   - updatedAt: string/timestamp (optional, max 50 chars)
//
// Collection: skills
// Document ID: auto-generated or string ID
// Fields:
//   - name: string (required, 1-100 chars)
//   - category: string (required, 1-100 chars)
//   - proficiency: number (optional, 0-100)
//   - iconUrl: string (optional, 0-1000 chars)
//   - featured: bool (optional)
//   - order: number (optional)
//   - createdAt: string/timestamp (optional, max 50 chars)
//   - updatedAt: string/timestamp (optional, max 50 chars)
//
// Collection: certifications
// Document ID: auto-generated or string ID
// Fields:
//   - title: string (required, 1-200 chars)
//   - issuer: string (required, 1-200 chars)
//   - issueDate: string (optional, 0-50 chars)
//   - expiryDate: string (optional, 0-50 chars)
//   - credentialId: string (optional, 0-200 chars)
//   - credentialUrl: string (optional, 0-1000 chars)
//   - badgeUrl: string (optional, 0-1000 chars)
//   - order: number (optional)
//   - createdAt: string/timestamp (optional, max 50 chars)
//   - updatedAt: string/timestamp (optional, max 50 chars)
//
// Collection: projects
// Document ID: auto-generated or string ID
// Fields:
//   - title: string (required, 1-200 chars)
//   - slug: string (required, 1-200 chars)
//   - description: string (required, 1-5000 chars)
//   - tags: list (required, max 30 items)
//   - tagline: string (optional, 0-300 chars)
//   - longDescription: string (optional, 0-10000 chars)
//   - thumbnailUrl: string (optional, 0-1000 chars)
//   - images: list (optional, max 30 items)
//   - liveUrl: string (optional, 0-1000 chars)
//   - repoUrl: string (optional, 0-1000 chars)
//   - featured: bool (optional)
//   - order: number (optional)
//   - publishedAt: string/timestamp (optional, max 50 chars)
//   - createdAt: string/timestamp (optional, max 50 chars)
//   - updatedAt: string/timestamp (optional, max 50 chars)
//
// Collection: contact_messages
// Document ID: auto-generated or string ID
// Fields:
//   - name: string (required, 1-100 chars)
//   - email: string (required, 3-254 chars, must contain '@')
//   - message: string (required, 1-5000 chars)
//   - createdAt: string/timestamp (required, max 50 chars if string)
//   - read: bool (optional on create: must not be true; editable only by admin)
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Core Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Restrict write operations exclusively to the configured admin UID
    function isAdmin() {
      return request.auth != null && request.auth.uid == "<MY_ADMIN_UID>";
    }

    // Validate that only allowed document keys are written
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate that all required keys are present
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate bounded string field
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Validate optional string field
    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) ||
        (data[field] is string && data[field].size() >= minLen && data[field].size() <= maxLen);
    }

    // Validate optional boolean field
    function isValidOptionalBool(data, field) {
      return !(field in data) || (data[field] is bool);
    }

    // Validate optional number field
    function isValidOptionalNumber(data, field) {
      return !(field in data) || (data[field] is number);
    }

    // Validate optional date (ISO string or Firestore timestamp)
    function isValidOptionalDate(data, field) {
      return !(field in data) ||
        (data[field] is timestamp) ||
        (data[field] is string && data[field].size() <= 50);
    }

    // Validate required date (ISO string or Firestore timestamp)
    function isValidDate(val) {
      return (val is timestamp) || (val is string && val.size() <= 50);
    }

    // Validate optional list with size cap to prevent resource exhaustion / DoS
    function isValidOptionalList(data, field, maxSize) {
      return !(field in data) ||
        (data[field] is list && data[field].size() <= maxSize);
    }

    // ===============================================================
    // Domain Validator Functions
    // ===============================================================

    function isValidProfile(data) {
      return hasOnlyAllowedFields([
        'name', 'title', 'headline', 'tagline', 'bio', 'about',
        'avatarUrl', 'resumeUrl', 'location', 'focusArea', 'mindset',
        'email', 'contactEmail', 'phone', 'linkedinUrl', 'githubUrl',
        'leetcodeUrl', 'codechefUrl', 'codeforcesUrl', 'twitterUrl',
        'socials', 'createdAt', 'updatedAt', 'id'
      ]) &&
      isValidOptionalString(data, 'id', 0, 100) &&
      isValidOptionalString(data, 'name', 0, 100) &&
      isValidOptionalString(data, 'title', 0, 200) &&
      isValidOptionalString(data, 'headline', 0, 200) &&
      isValidOptionalString(data, 'tagline', 0, 200) &&
      isValidOptionalString(data, 'bio', 0, 5000) &&
      isValidOptionalString(data, 'about', 0, 10000) &&
      isValidOptionalString(data, 'avatarUrl', 0, 1000) &&
      isValidOptionalString(data, 'resumeUrl', 0, 1000) &&
      isValidOptionalString(data, 'location', 0, 100) &&
      isValidOptionalString(data, 'focusArea', 0, 200) &&
      isValidOptionalString(data, 'mindset', 0, 200) &&
      isValidOptionalString(data, 'email', 0, 254) &&
      isValidOptionalString(data, 'contactEmail', 0, 254) &&
      isValidOptionalString(data, 'phone', 0, 50) &&
      isValidOptionalString(data, 'linkedinUrl', 0, 500) &&
      isValidOptionalString(data, 'githubUrl', 0, 500) &&
      isValidOptionalString(data, 'leetcodeUrl', 0, 500) &&
      isValidOptionalString(data, 'codechefUrl', 0, 500) &&
      isValidOptionalString(data, 'codeforcesUrl', 0, 500) &&
      isValidOptionalString(data, 'twitterUrl', 0, 500) &&
      isValidOptionalList(data, 'socials', 20) &&
      isValidOptionalDate(data, 'createdAt') &&
      isValidOptionalDate(data, 'updatedAt');
    }

    function isValidEducation(data) {
      return hasOnlyAllowedFields([
        'institution', 'degree', 'fieldOfStudy', 'startDate', 'endDate',
        'isCurrent', 'grade', 'location', 'description', 'order',
        'createdAt', 'updatedAt', 'id'
      ]) &&
      hasRequiredFields(['institution', 'degree']) &&
      isValidOptionalString(data, 'id', 0, 100) &&
      isValidString(data.institution, 1, 200) &&
      isValidString(data.degree, 1, 200) &&
      isValidOptionalString(data, 'fieldOfStudy', 0, 200) &&
      isValidOptionalString(data, 'startDate', 0, 50) &&
      isValidOptionalString(data, 'endDate', 0, 50) &&
      isValidOptionalBool(data, 'isCurrent') &&
      isValidOptionalString(data, 'grade', 0, 100) &&
      isValidOptionalString(data, 'location', 0, 100) &&
      isValidOptionalString(data, 'description', 0, 5000) &&
      isValidOptionalNumber(data, 'order') &&
      isValidOptionalDate(data, 'createdAt') &&
      isValidOptionalDate(data, 'updatedAt');
    }

    function isValidSkill(data) {
      return hasOnlyAllowedFields([
        'name', 'category', 'proficiency', 'iconUrl', 'featured',
        'order', 'createdAt', 'updatedAt', 'id'
      ]) &&
      hasRequiredFields(['name', 'category']) &&
      isValidOptionalString(data, 'id', 0, 100) &&
      isValidString(data.name, 1, 100) &&
      isValidString(data.category, 1, 100) &&
      (!( 'proficiency' in data ) || (data.proficiency is number && data.proficiency >= 0 && data.proficiency <= 100)) &&
      isValidOptionalString(data, 'iconUrl', 0, 1000) &&
      isValidOptionalBool(data, 'featured') &&
      isValidOptionalNumber(data, 'order') &&
      isValidOptionalDate(data, 'createdAt') &&
      isValidOptionalDate(data, 'updatedAt');
    }

    function isValidCertification(data) {
      return hasOnlyAllowedFields([
        'title', 'issuer', 'issueDate', 'expiryDate', 'credentialId',
        'credentialUrl', 'badgeUrl', 'order', 'createdAt', 'updatedAt', 'id'
      ]) &&
      hasRequiredFields(['title', 'issuer']) &&
      isValidOptionalString(data, 'id', 0, 100) &&
      isValidString(data.title, 1, 200) &&
      isValidString(data.issuer, 1, 200) &&
      isValidOptionalString(data, 'issueDate', 0, 50) &&
      isValidOptionalString(data, 'expiryDate', 0, 50) &&
      isValidOptionalString(data, 'credentialId', 0, 200) &&
      isValidOptionalString(data, 'credentialUrl', 0, 1000) &&
      isValidOptionalString(data, 'badgeUrl', 0, 1000) &&
      isValidOptionalNumber(data, 'order') &&
      isValidOptionalDate(data, 'createdAt') &&
      isValidOptionalDate(data, 'updatedAt');
    }

    function isValidProject(data) {
      return hasOnlyAllowedFields([
        'title', 'slug', 'description', 'tags', 'tagline', 'longDescription',
        'thumbnailUrl', 'images', 'liveUrl', 'repoUrl', 'featured', 'order',
        'publishedAt', 'createdAt', 'updatedAt', 'id'
      ]) &&
      hasRequiredFields(['title', 'slug', 'description', 'tags']) &&
      isValidOptionalString(data, 'id', 0, 100) &&
      isValidString(data.title, 1, 200) &&
      isValidString(data.slug, 1, 200) &&
      isValidString(data.description, 1, 5000) &&
      (data.tags is list && data.tags.size() <= 30) &&
      isValidOptionalString(data, 'tagline', 0, 300) &&
      isValidOptionalString(data, 'longDescription', 0, 10000) &&
      isValidOptionalString(data, 'thumbnailUrl', 0, 1000) &&
      isValidOptionalList(data, 'images', 30) &&
      isValidOptionalString(data, 'liveUrl', 0, 1000) &&
      isValidOptionalString(data, 'repoUrl', 0, 1000) &&
      isValidOptionalBool(data, 'featured') &&
      isValidOptionalNumber(data, 'order') &&
      isValidOptionalDate(data, 'publishedAt') &&
      isValidOptionalDate(data, 'createdAt') &&
      isValidOptionalDate(data, 'updatedAt');
    }

    function isValidContactMessageCreate(data) {
      return hasOnlyAllowedFields(['name', 'email', 'message', 'createdAt', 'read', 'id']) &&
        hasRequiredFields(['name', 'email', 'message', 'createdAt']) &&
        isValidOptionalString(data, 'id', 0, 100) &&
        isValidString(data.name, 1, 100) &&
        (data.email is string && data.email.size() >= 3 && data.email.size() <= 254 && data.email.matches(".*@.*")) &&
        isValidString(data.message, 1, 5000) &&
        data.createdAt == request.time &&
        (!('read' in data) || data.read == false);
    }

    function isValidContactMessageUpdate(newData, oldData) {
      return hasOnlyAllowedFields(['name', 'email', 'message', 'createdAt', 'read', 'id']) &&
        newData.name == oldData.name &&
        newData.email == oldData.email &&
        newData.message == oldData.message &&
        newData.createdAt == oldData.createdAt &&
        (!('read' in newData) || (newData.read is bool));
    }

    // ===============================================================
    // Collection Match Rules
    // ===============================================================

    // 1. Profile Collection & Document
    match /profile/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProfile(request.resource.data);
      allow delete: if isAdmin();
    }

    // 2. Education Collection
    match /education/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidEducation(request.resource.data);
      allow delete: if isAdmin();
    }

    // 3. Skills Collection
    match /skills/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidSkill(request.resource.data);
      allow delete: if isAdmin();
    }

    // 4. Certifications Collection
    match /certifications/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidCertification(request.resource.data);
      allow delete: if isAdmin();
    }

    // 5. Projects Collection
    match /projects/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProject(request.resource.data);
      allow delete: if isAdmin();
    }

    // 6. Contact Messages Collection
    match /contact_messages/{messageId} {
      allow read, delete: if isAdmin();
      allow create: if isValidContactMessageCreate(request.resource.data);
      allow update: if isAdmin() && isValidContactMessageUpdate(request.resource.data, resource.data);
    }

    // ===============================================================
    // Default Deny on all unmatched paths
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
